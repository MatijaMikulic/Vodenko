# ── Build output ────────────────────────────────────────────────────
# Ignore any bin/ or obj/ folder anywhere
**/bin/
**/obj/
**/out/

# Publish and package output
**/publish/
*.wpp.targets
*.pubxml
*.publishproj

# ── Visual Studio ──────────────────────────────────────────────────
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db

# Auto‑generated AssemblyInfo files
**/*.AssemblyAttributes.cs
**/*.AssemblyInfo.cs

# MSBuild autogenerated
*.log
*.vspscc
*.vssscc
*.cachefile

# Visual Studio Installer projects
*.msi
*.msm
*.mst

# ── IDE settings ───────────────────────────────────────────────────
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# Rider / IntelliJ
.idea/

# JetBrains ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# NCrunch
_NCrunch_*/
nCrunchTemp_*

# TeamCity
_TeamCity*

# DotCover
*.dotCover

# AxoCover
.axoCover/
!.axoCover/settings.json

# CodeRush
.cr/

# ── NuGet & packages ────────────────────────────────────────────────
# NuGet packages folder
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# NuGet generated files
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
project.assets.json
*.nuget.g.props
*.nuget.g.targets

# ── ASP.NET & web ─────────────────────────────────────────────────
ScaffoldingReadMe.txt
wwwroot/
ClientBin/
*.publishsettings
*.azurePubxml
PublishScripts/

# ── Entity Framework ───────────────────────────────────────────────
**/Migrations/*.Designer.cs
**/Migrations/*Snapshot.cs

# ── Test results & coverage ────────────────────────────────────────
TestResults/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
*.opencover.xml
*.lcov

# ── Logs & temp ────────────────────────────────────────────────────
*.log
logs/
**/.cache/
*.tmp
*.temp

# ── Docker & environment ───────────────────────────────────────────
docker-compose.override.yml
docker-compose.debug.yml
.env
*.env

# ── Node.js / front‑end ────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd

